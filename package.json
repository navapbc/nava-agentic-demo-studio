{
  "name": "nava-agentic-demo-studio",
  "version": "0.4.1",
  "private": true,
  "type": "module",
  "description": "Local product presentations with editable slides and polished demos included.",
  "bin": {
    "demo-studio": "bin/demo-studio.mjs",
    "presentation-studio": "bin/presentation-studio.mjs"
  },
  "scripts": {
    "make": "node bin/demo-studio.mjs make examples/benefits-portal.script.json",
    "plan": "node bin/demo-studio.mjs plan examples/parallel-apps.trace.json examples/parallel-apps.project.json",
    "serve": "node bin/demo-studio.mjs serve",
    "doctor": "node bin/demo-studio.mjs doctor",
    "check": "for file in bin/*.mjs lib/*.mjs web/*.js; do node --check \"$file\" || exit 1; done",
    "test": "node --test test/*.test.mjs",
    "e2e": "node --test test/e2e/*.e2e.mjs",
    "presentation": "node bin/presentation-studio.mjs build examples/presentation-system.presentation.json --out exports/presentation"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "license": "MIT",
  "dependencies": {
    "jszip": "^3.10.2",
    "mp4-muxer": "^5.2.2",
    "playwright-core": "^1.63.0",
    "pptxgenjs": "^4.0.1"
  },
  "optionalDependencies": {
    "kokoro-js": "^1.2.1"
  },
  "overrides": {
    "image-size": "2.0.4",
    "sharp": "0.35.5"
  }
}
